# Copy to backend/.env for local use. Never commit .env.
# Supabase: Project Settings → Database → Connection string → URI (use "Transaction" pooler for serverless)

# Example (replace password + project ref):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_char_random_secret_here_xxxxx

# AES key for customer phone/email at rest (64 hex chars preferred)
PII_ENCRYPTION_KEY=replace_with_at_least_32_char_random_secret_here_yyyyy

# Cloudflare frontend origins (comma-separated). Required when NODE_ENV=production.
FRONTEND_ORIGIN=https://h2oorg.com,https://www.h2oorg.com

# Razorpay (Test keys first). Dashboard → Settings → API Keys / Webhooks
# Webhook URL: https://h2o-pos-api.onrender.com/api/webhooks/razorpay
# Events: payment.captured, payment.failed
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Twilio SMS (optional). Without these, messages are written to message_outbox as status=logged.
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM=+91xxxxxxxxxx

# Optional cron auth for birthday-offers + Tally/Zoho export jobs
CRON_SECRET=replace_with_long_random_cron_secret

# Tally (optional). Without TALLY_HTTP_URL, POS generates downloadable XML only.
# Point at a Tally Gateway / HTTP listener that accepts Import Data XML.
TALLY_HTTP_URL=
TALLY_HTTP_TOKEN=

# Zoho Books (optional alternative ledger). All four required to enable sync.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_BASE=https://www.zohoapis.in/books/v3

NODE_ENV=development
PORT=5000
