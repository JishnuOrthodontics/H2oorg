# Prefer backend/.env locally.
# Database: Supabase Project Settings → Database → Connection string (URI)

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=replace_with_at_least_32_char_random_secret_here_xxxxx
PII_ENCRYPTION_KEY=replace_with_at_least_32_char_random_secret_here_yyyyy
FRONTEND_ORIGIN=https://h2oorg.com,https://www.h2oorg.com
# Razorpay Test keys (Dashboard → API Keys / Webhooks)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_signing_secret

NODE_ENV=development
PORT=5000
